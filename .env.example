# Copia este archivo como .env y rellénalo. Nunca subas el .env a GitHub.

# Cerebro y voz: "openai" (voz a voz, por defecto) o "claude"
# NIMEA_MOTOR=openai
OPENAI_API_KEY=
# OPENAI_MODELO_REALTIME=gpt-realtime-2.1-mini
# OPENAI_VOZ=marin
# Dejar que la interrumpan mientras habla (solo si el micro cancela bien el eco)
# NIMEA_INTERRUMPIR=0

# Claude (solo con NIMEA_MOTOR=claude)
# ANTHROPIC_API_KEY=
# NIMEA_MODELO=claude-opus-5-5
# NIMEA_ESFUERZO=low
# NIMEA_FALLBACKS=1

# App de la familia (Base44): URL base de las funciones y token del dispositivo (empieza por nim_)
NIMEA_API_URL=https://app.base44.com/api/apps/6ae01f8e1a5dbeb851837e78/functions
NIMEA_API_TOKEN=

# Transcripción de las respuestas grabadas para la familia (y voz con NIMEA_MOTOR=claude)
# NIMEA_STT=openai       # o elevenlabs, o whisper (local)
# NIMEA_TTS=openai       # o elevenlabs, o piper (local); solo con NIMEA_MOTOR=claude
# OPENAI_MODELO_TTS=gpt-4o-mini-tts
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOZ=
# NIMEA_PIPER_MODELO=/ruta/es_ES-voz.onnx

# Palabra de activación. Sin modelo propio, se detecta "Nimea" con Whisper local.
# NIMEA_MODELO_PALABRA=/ruta/nimea.onnx
# NIMEA_UMBRAL_PALABRA=0.5

# Comportamiento
# NIMEA_HORARIO_DESCANSO=22:30-08:30
# NIMEA_SILENCIO_DORMIR=25
# NIMEA_VOLUMEN=0.9
